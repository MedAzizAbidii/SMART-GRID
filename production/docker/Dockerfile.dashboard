# Dockerfile.dashboard — nginx serving the static dashboard + reverse-proxying
# /api, /ws, /health, /metrics to the backend service. Standard edge-tier
# separation: the dashboard's static assets can be served/cached/CDN'd
# independently of the API, without needing Python installed at all.
#
# Build (from smartgrid_simulation/):
#   docker build -f production/docker/Dockerfile.dashboard -t smartgrid-dashboard:1.0.0 .

FROM nginx:1.27-alpine

COPY dashboard/ /usr/share/nginx/html/
COPY production/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# 127.0.0.1, not localhost: wget resolves "localhost" to ::1 first on this
# base image, and nginx isn't bound to IPv6, so the check always failed
# with "connection refused" even though the server was working fine —
# found via an actual `docker compose up` run, not caught by static review.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
