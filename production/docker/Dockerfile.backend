# Dockerfile.backend — FastAPI backend (api_server.py).
#
# By default runs the AI model IN-PROCESS (get_detector()), exactly as before
# Phase 6 — no behavior change for a standalone container. Set
# SGRID_INFERENCE_SERVICE_URL=http://inference:8100 (as docker-compose.yml
# does) to instead proxy /api/detect to the separate inference container.
#
# Build (from smartgrid_simulation/):
#   docker build -f production/docker/Dockerfile.backend -t smartgrid-backend:1.0.0 .
# Run standalone (in-process model, needs outputs/ + data/ mounted):
#   docker run -p 8000:8000 -v $(pwd)/../data:/data smartgrid-backend:1.0.0

FROM python:3.10-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-prod.txt ./requirements-prod.txt
# requirements-prod.txt is the trimmed runtime set — pypowsybl/seaborn/
# matplotlib/shap and their numba/llvmlite chain are excluded because no
# production module imports them (verified by grep), and they add ~350MB
# the image doesn't need. Use requirements.txt only for local dev/research.
#
# torch is installed separately, pinned to the official CPU-only wheel index
# — this container has no GPU, and the default PyPI wheel can otherwise pull
# CUDA runtime libraries (multiple hundred extra MB) depending on the build
# environment's detected platform tags.
# --timeout/--retries: torch wheels are 200-500MB; pip's default 15s read
# timeout is too tight on a slow/unstable connection and causes spurious
# ReadTimeoutError mid-download.
RUN pip install --no-cache-dir --timeout=180 --retries=8 \
        torch --extra-index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir --timeout=180 --retries=8 \
        -r requirements-prod.txt

COPY api_server.py config.py smart_meters_simulator.py ./
COPY ml_pipeline/ ./ml_pipeline/
COPY blockchain/ ./blockchain/
COPY dashboard/ ./dashboard/
COPY production/ ./production/
COPY outputs/early_stopping_final/ ./outputs/early_stopping_final/
COPY outputs/test_run_now/ ./outputs/test_run_now/
# DataEngine.__init__() hard-fails at import time (before uvicorn can even
# start) if neither the clean nor attack dataset is present — bundling the
# small "fast" variants (~2.2MB total) means the image boots standalone on
# a host like Render with no volume mount, instead of requiring one.
COPY data/clean/smartgrid_clean_fast.csv ./data/clean/smartgrid_clean_fast.csv
COPY data/attacks/attacks_fast.csv ./data/attacks/attacks_fast.csv

# Non-root runtime user (a container running as root is an unnecessary
# privilege-escalation surface if the app is ever compromised).
RUN useradd --create-home --shell /bin/bash appuser \
    && mkdir -p /app/logs /data \
    && chown -R appuser:appuser /app /data
USER appuser

ENV PYTHONUNBUFFERED=1 \
    SGRID_ENVIRONMENT=production \
    SGRID_LOG_DIR=/app/logs

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health',timeout=3).status==200 else 1)"

CMD ["python", "-m", "uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8000"]
