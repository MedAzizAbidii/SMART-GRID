# Copy to `.env` and fill in real values before deploying to staging/production.
# NEVER commit a real `.env` file — it is (or should be) git-ignored.

# ── environment ──────────────────────────────────────────────────────────────
SGRID_ENVIRONMENT=development
SGRID_DEBUG=false

# ── API ──────────────────────────────────────────────────────────────────────
SGRID_API_HOST=0.0.0.0
SGRID_API_PORT=8000
SGRID_CORS_ALLOWED_ORIGINS=["http://localhost:8080"]
SGRID_RATE_LIMIT_REQUESTS_PER_MINUTE=120

# ── security — GENERATE A REAL SECRET, do not use this placeholder ──────────
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SGRID_JWT_SECRET_KEY=CHANGE_ME_INSECURE_DEV_ONLY_SECRET
SGRID_JWT_ALGORITHM=HS256
SGRID_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── model ────────────────────────────────────────────────────────────────────
SGRID_MODEL_DIR_V3=outputs/early_stopping_final
SGRID_MODEL_DIR_V2=outputs/test_run_now
# Leave unset for in-process model loading; set for the 3-container topology:
# SGRID_INFERENCE_SERVICE_URL=http://inference:8100

# ── blockchain ───────────────────────────────────────────────────────────────
SGRID_BLOCKCHAIN_BLOCK_SIZE=20

# ── logging ──────────────────────────────────────────────────────────────────
SGRID_LOG_DIR=logs
SGRID_LOG_LEVEL=INFO

# ── existing IPFS/Pinata placeholders (unused by any current code path) ─────
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=
SMARTGRID_IPFS_PASSPHRASE=
