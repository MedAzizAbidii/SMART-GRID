# Copy this file to .env and fill in real values. NEVER commit .env.
#
# Sepolia RPC endpoint from a provider you control (Alchemy or Infura).
# Alchemy: https://www.alchemy.com  -> create app -> Sepolia -> "HTTPS" URL
# Infura:  https://www.infura.io    -> create project -> Sepolia endpoint
SEPOLIA_RPC_URL=

# Private key of the deployer/authority wallet, WITHOUT the 0x prefix is
# also fine (ethers accepts both). Generate one with:
#   node scripts/generate-wallet.js
# Fund it with Sepolia test ETH from a faucet (e.g. https://sepoliafaucet.com
# or https://www.alchemy.com/faucets/ethereum-sepolia) before deploying.
# NEVER use a wallet that holds real funds.
DEPLOYER_PRIVATE_KEY=

# Optional: verify contracts on Etherscan after deploy.
# https://etherscan.io/apis -> create a free API key
ETHERSCAN_API_KEY=
